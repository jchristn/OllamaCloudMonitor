# Shell environment variable examples. Never commit real bearer tokens.
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8080
MONITOR_WEB_ROOT=dashboard/dist
MONITOR_SPEC_PATH=postman/specs/monitor.openapi.json
# Keep the production upstream at https://ollama.com.
# OLLAMA_BASE_URL is only needed to route integration tests to a simulation.
# Optional shared configured-account mode; set secrets only in your local environment.
OLLAMA_CLOUD_BEARER_TOKEN=
